<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Check suspicious emails for common phishing indicators.">
  <title>Phish Outta Water</title>

  <link rel="stylesheet" href="/css/styles.css">
  <script src="/js/app.js" defer></script>

  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            navy: {
              DEFAULT: "#354273",
              dark: "#29365f"
            }
          },
          fontFamily: {
            sans: ["DM Sans", "Arial", "sans-serif"],
            display: ["Playfair Display", "Georgia", "serif"]
          }
        }
      }
    };
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">
  <script src="/js/app.js" defer></script>
</head>

<body class="min-h-screen bg-white font-sans text-black">
  <header class="flex min-h-[88px] items-center justify-between gap-5 px-[5%] py-5 lg:px-[3.1%]">
    <a class="text-[24px] font-medium tracking-[-1.8px] text-black no-underline sm:text-[28px]" href="/" aria-label="Phish Outta Water home">
      Phish Outta Water
    </a>
    <a href="#learn" class="rounded-full bg-navy px-4 py-3 text-center text-[11px] font-bold text-white transition hover:bg-navy-dark sm:px-6 sm:text-[13px]">
      Learn About Phishing <span aria-hidden="true">↗</span>
    </a>
  </header>

  <main class="mx-auto mt-9 w-[90%] max-w-[1440px] lg:mt-12 lg:w-[93.8%]">
    <section class="mb-6 text-center" aria-labelledby="page-title">
      <h1 id="page-title" class="font-display text-[34px] font-bold leading-tight tracking-[-1.5px] sm:text-5xl lg:text-[56px]">
        Paste a Suspicious Email Here
      </h1>
      <p class="mt-2 font-display text-xl leading-snug sm:text-2xl lg:text-4xl">
        Our Agent will check for common phishing indicators.
      </p>
    </section>

    <form id="analyzer-form" class="text-center">
      <label class="sr-only" for="email-message">Suspicious email content</label>
      <textarea
        id="email-message"
        name="message"
        placeholder="Paste the email's subject and message here..."
        required
        minlength="10"
        spellcheck="true"
        class="block min-h-[300px] w-full resize-y rounded-[22px] border-[5px] border-navy bg-[#eaeaec] p-[18px] text-left text-base leading-relaxed text-black outline-none transition placeholder:text-[#85858c] focus:border-[#53649c] focus:ring-4 focus:ring-navy/10 sm:min-h-[380px] sm:rounded-[30px] sm:border-[7px] sm:p-[25px] sm:text-[17px]"
      ></textarea>

      <div class="flex min-h-[35px] items-center justify-between px-2 pt-1 text-xs text-[#707078]">
        <span id="character-count">0 characters</span>
        <button id="clear-button" type="button" class="pl-3 py-1 text-navy hover:underline">Clear text</button>
      </div>

      <div class="h-px bg-[#e5e5e8]"></div>

      <button
        id="analyze-button"
        type="submit"
        class="mx-auto mt-7 inline-flex min-h-[60px] min-w-[220px] items-center justify-center gap-3 rounded-full bg-navy px-8 py-4 font-display text-xl text-white transition hover:-translate-y-0.5 hover:bg-navy-dark disabled:cursor-wait disabled:opacity-75 sm:mt-10 sm:min-h-[69px] sm:min-w-[232px]"
      >
        <span class="button-label">Analyze Message</span>
        <span class="button-spinner hidden h-[17px] w-[17px] animate-spin rounded-full border-2 border-white/40 border-t-white" aria-hidden="true"></span>
      </button>
      <p class="mt-3 text-xs text-[#707078]">
        Don't include passwords, payment details, or other sensitive information.
      </p>
    </form>

    <section id="results-section" aria-live="polite" hidden class="mt-12 rounded-2xl border border-[#e5e5e8] bg-[#fbfbfc] p-5 sm:p-8">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <p class="mb-2 text-[11px] font-bold tracking-[1.7px] text-navy">ANALYSIS RESULTS</p>
          <h2 id="result-title" class="text-2xl font-semibold">Your email analysis</h2>
        </div>
        <span id="risk-badge" class="rounded-full bg-[#e9e9ed] px-4 py-2 text-xs font-bold text-navy">Result</span>
      </div>

      <p id="result-summary" class="my-5 leading-relaxed"></p>

      <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
        <div class="rounded-xl border border-[#e5e5e8] bg-white p-5">
          <h3 class="mb-3 text-[15px] font-bold">What we noticed</h3>
          <ul id="indicators-list" class="list-disc space-y-2 pl-5 text-sm leading-relaxed"></ul>
          <p id="indicators-empty" hidden class="text-sm text-[#707078]">No specific indicators were returned.</p>
        </div>
        <div class="rounded-xl border border-[#e5e5e8] bg-white p-5">
          <h3 class="mb-3 text-[15px] font-bold">What you should do</h3>
          <ul id="recommendations-list" class="list-disc space-y-2 pl-5 text-sm leading-relaxed"></ul>
          <p id="recommendations-empty" hidden class="text-sm text-[#707078]">No recommendations were returned.</p>
        </div>
      </div>

      <p class="mt-5 text-xs leading-relaxed text-[#707078]">
        This tool can make mistakes. If an email seems suspicious, verify it through an official website or a trusted contact instead of replying or clicking its links.
      </p>
    </section>

  </main>

  <footer class="mx-auto flex min-h-[115px] w-[90%] max-w-[1440px] flex-wrap items-center gap-x-8 gap-y-4 border-t border-[#e5e5e8] px-0 py-7 sm:px-[5%] lg:w-[93.8%]">
    <a href="/" class="inline-flex items-center gap-2 font-bold text-black no-underline">
      <span aria-hidden="true" class="text-xl">🚫</span>
      Phish Outta Water
    </a>
    <nav aria-label="Footer navigation" class="flex gap-7 text-sm text-[#707078]">
      <a href="#analyzer-form" class="hover:text-navy">Features</a>
      <a href="#learn" class="hover:text-navy">Learn more</a>
    </nav>
    <span class="text-xs text-[#707078] sm:ml-auto">A student project for learning email security.</span>
  </footer>
</body>
</html>
